{
  "name": "asuma-multi-device",
  "version": "1.0.0",
  "description": "Modern WhatsApp Bot Framework built with Baileys, Pure ESM, and Bun-first optimization",
  "type": "module",
  "main": "index.js",
  "author": "ditss",
  "license": "MIT",
  "homepage": "https://github.com/asuma-labs/asuma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asuma-labs/asuma.git"
  },
  "bugs": {
    "url": "https://github.com/asuma-labs/asuma/issues"
  },
  "keywords": [
    "whatsapp-bot",
    "baileys",
    "multi-device",
    "bun",
    "esm",
    "plugin-system",
    "asuma"
  ],
  "scripts": {
    "start": "bun index.js",
    "start:node": "node index.js",
    "dev": "bun --watch index.js",
    "dev:node": "node --watch index.js",
    "lint": "bun run lint:check",
    "lint:check": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"plugins/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"plugins/**/*.js\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf temp/ sessions/ logs/",
    "preinstall": "bunx only-allow bun"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "latest",
    "@hapi/boom": "^10.0.1",
    "pino": "^8.21.0",
    "pino-pretty": "^11.2.2",
    "chalk": "^5.3.0",
    "node-cache": "^5.1.2",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "jimp": "^0.22.12",
    "file-type": "^19.0.0",
    "awesome-phonenumber": "^6.8.0",
    "axios": "^1.7.2",
    "moment-timezone": "^0.5.45"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "bun-types": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "bun": {
    "watch": {
      "include": ["src/**/*", "plugins/**/*", "config/**/*"],
      "exclude": ["node_modules/**/*", "temp/**/*", "sessions/**/*"]
    }
  }
}
